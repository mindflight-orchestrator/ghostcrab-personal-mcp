# Ghostcrab application
NODE_ENV=development

# PostgreSQL connection for the future MCP server runtime
DATABASE_URL=postgres://ghostcrab:ghostcrab@localhost:5432/ghostcrab
PG_POOL_MAX=10

# Embeddings runtime:
# - disabled: default honest BM25-only runtime
# - null: no-op provider for tests that must never touch vectors
# - fake: deterministic local vectors for validation and hybrid-search tests
# - fixture: vectors loaded from a JSON fixture file
# - openrouter: real provider using the OpenRouter embeddings API
GHOSTCRAB_EMBEDDINGS_MODE=disabled
GHOSTCRAB_EMBEDDING_DIMENSIONS=1536
GHOSTCRAB_EMBEDDINGS_FIXTURE_PATH=
GHOSTCRAB_EMBEDDINGS_MODEL=openai/text-embedding-3-small
GHOSTCRAB_EMBEDDINGS_API_KEY=
GHOSTCRAB_EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
GHOSTCRAB_EMBEDDINGS_TIMEOUT_MS=30000
GHOSTCRAB_HYBRID_BM25_WEIGHT=0.6
GHOSTCRAB_HYBRID_VECTOR_WEIGHT=0.4
GHOSTCRAB_CONFIG_PATH=
GHOSTCRAB_ENV_PATH=

# Native Docker Postgres image
POSTGRES_USER=ghostcrab
POSTGRES_PASSWORD=ghostcrab
POSTGRES_DB=ghostcrab
PG_PORT=5432

# Boot/seed should run against the native Postgres stack with pg_facets,
# pg_dgraph, and pg_pragma loaded.
MFO_NATIVE_EXTENSIONS=native

# Temporary Docker defaults until the canonical version pinning doc lands.
GHOSTCRAB_PGVECTOR_IMAGE=pgvector/pgvector:pg17
GHOSTCRAB_PG_MAJOR=17

# --- Telemetry (anonymous, opt-in) ---
MCP_TELEMETRY=0
GHOSTCRAB_TELEMETRY_ENDPOINT=
GHOSTCRAB_TELEMETRY_TIMEOUT_MS=1500
GHOSTCRAB_TELEMETRY_STATE_DIR=
GHOSTCRAB_TELEMETRY_DEBUG=0
GHOSTCRAB_AGENT_HOST=
GHOSTCRAB_AGENT_HOST_SOURCE=
GHOSTCRAB_EXECUTION_MODE=
